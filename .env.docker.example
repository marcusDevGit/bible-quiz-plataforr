# Variáveis de exemplo para o ambiente Docker local (nunca reutilize estes valores em produção)
POSTGRES_USER=biblequiz
POSTGRES_PASSWORD=biblequiz_dev_only
POSTGRES_DB=biblequiz

# Em produção, defina um segredo forte e aleatório
JWT_SECRET=troque_por_um_jwt_secret_seguro
NODE_ENV=production

# URL da API acessível pelo navegador para o bundle do Painel Admin
VITE_BASE_URL=http://localhost:3001

